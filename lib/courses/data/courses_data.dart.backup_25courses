  /// Get courses by category
  static List<Course> getByCategory(CourseCategory category) {
    return allCourses.where((c) => c.category == category).toList();
  }

  /// Get courses by difficulty
  static List<Course> getByDifficulty(DifficultyLevel difficulty) {
    return allCourses.where((c) => c.difficulty == difficulty).toList();
  }

  /// Get course by ID
  static Course? getById(String id) {
    try {
      return allCourses.firstWhere((c) => c.id == id);
    } catch (e) {
      return null;
    }
  }

  /// Get beginner-friendly courses
  static List<Course> getBeginnerCourses() {
    return allCourses
        .where((c) => c.difficulty == DifficultyLevel.beginner)
        .toList();
  }

  /// Get popular courses (first 6)
  static List<Course> getPopularCourses() {
    return allCourses.take(6).toList();
  }

  /// Search courses
  static List<Course> search(String query) {
    final q = query.toLowerCase();
    return allCourses.where((c) {
      return c.name.toLowerCase().contains(q) ||
          c.description.toLowerCase().contains(q) ||
          c.tags.any((t) => t.toLowerCase().contains(q));
    }).toList();
  }

  /// Group courses by category
  static Map<CourseCategory, List<Course>> groupByCategory() {
    final map = <CourseCategory, List<Course>>{};
    for (final course in allCourses) {
      if (!map.containsKey(course.category)) {
        map[course.category] = [];
      }
      map[course.category]!.add(course);
    }
    return map;
  }
